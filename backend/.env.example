# ZeniTEK Backend Environment Variables
# Copy this file to .env and fill in your actual values

# MongoDB
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/zenitek?retryWrites=true&w=majority

# ─── Authentication (REQUIRED — the server will not start without these) ───
# Long random secret (min 32 chars) used to sign login tokens. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=change_me_to_a_long_random_secret

# Client Admin — website CMS at /admin (role: client)
CLIENT_ADMIN_USERNAME=change_me
CLIENT_ADMIN_PASSWORD=change_me

# Developer Admins — bug triage dashboard at /admin/developer (role: developer)
# Comma-separated username:password pairs; each person is tracked individually.
DEVELOPER_USERS=developer1:change_me,developer2:change_me

# Testers — bug reporting dashboard at /admin/tester (role: tester)
TESTER_USERS=tester1:change_me,tester2:change_me

# Any password above may instead be a bcrypt hash (value starting with $2), e.g.:
#   node -e "console.log(require('bcryptjs').hashSync('your-password', 12))"

# Cloudinary (Sign up at cloudinary.com and create a free account)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# SMTP for email notifications
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
ADMIN_EMAIL=sales@zenitek.in

# WhatsApp Number
WHATSAPP_NUMBER=918098613422

# Frontend site(s) allowed to call this API (CORS), comma-separated, no trailing slash
FRONTEND_URL=http://localhost:3000

# Server Port
PORT=5000
